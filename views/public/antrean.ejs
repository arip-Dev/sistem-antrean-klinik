<%- include('../partials/head', { title: 'Pantau Antrean' }) %>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex flex-col">
  
  <!-- Header Mobile -->
  <header class="bg-blue-600 text-white p-6 shadow-md rounded-b-3xl mb-6 relative">
    <div class="absolute top-4 right-4 flex items-center gap-2 text-xs font-semibold bg-white/20 px-3 py-1.5 rounded-full">
      <span id="koneksi-status" class="w-2 h-2 rounded-full bg-red-400 animate-pulse"></span>
      <span id="koneksi-text">Menghubungkan</span>
    </div>
    
    <div class="text-center mt-6 mb-2">
      <span class="text-4xl block mb-2">🏥</span>
      <h1 class="text-xl font-bold">Klinik SiAntre</h1>
      <p class="text-blue-100 text-sm opacity-90">Pantau Antrean Langsung</p>
    </div>
  </header>

  <main class="flex-1 px-4 max-w-md w-full mx-auto pb-20">
    
    <!-- Sedang Dipanggil -->
    <div class="bg-white rounded-3xl shadow-lg border border-gray-100 p-6 mb-8 text-center relative overflow-hidden transform transition-transform" id="box-dipanggil">
      <div class="absolute top-0 left-0 w-full h-1.5 bg-blue-500"></div>
      <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Sedang Dipanggil</p>
      
      <div id="panggilan-nomor" class="text-7xl font-black text-gray-800 tracking-tighter mb-2">-</div>
      <div id="panggilan-nama" class="text-lg font-bold text-gray-600 mb-2 truncate">Belum ada panggilan</div>
      <div id="panggilan-prioritas" class="inline-block mt-2"></div>
    </div>

    <!-- Antrean Menunggu -->
    <div>
      <div class="flex items-center justify-between mb-4 px-2">
        <h2 class="text-lg font-bold text-gray-700">Daftar Menunggu</h2>
        <span class="text-xs font-semibold text-gray-500 bg-gray-200 px-2 py-1 rounded-md" id="jumlah-menunggu">0 Pasien</span>
      </div>
      
      <div id="list-menunggu" class="space-y-3">
        <!-- List injected by JS -->
        <div class="bg-white rounded-2xl p-6 text-center text-gray-500 shadow-sm border border-gray-100">
          Memuat data...
        </div>
      </div>
    </div>

  </main>

  <!-- Sticky Bottom CTA -->
  <div class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-[0_-10px_40px_rgba(0,0,0,0.05)]">
    <div class="max-w-md mx-auto">
      <a href="/" class="block w-full bg-blue-50 text-blue-700 py-3 rounded-xl font-bold text-center border border-blue-100 hover:bg-blue-100 transition-colors">
        Kembali ke Beranda
      </a>
    </div>
  </div>

  <script src="/js/antrean-pasien.js"></script>
</body>
</html>