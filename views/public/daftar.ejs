<%- include('../partials/head', { title: 'Pendaftaran Antrean Mandiri' }) %>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex items-center justify-center p-4">

  <!-- Halaman Pendaftaran -->
  <div id="page-daftar" class="w-full max-w-md">
    <div class="text-center mb-8">
      <span class="text-5xl block mb-4">🏥</span>
      <h1 class="text-2xl font-bold text-gray-800">Klinik SiAntre</h1>
      <p class="text-gray-500">Pendaftaran Antrean Mandiri</p>
    </div>

    <div class="bg-white rounded-3xl shadow-xl p-8">
      <form id="form-daftar" class="space-y-5">
        
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
            <input type="text" name="nama_pasien" required placeholder="Masukkan nama Anda" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all">
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Usia</label>
              <input type="number" name="usia" min="0" max="150" required placeholder="Tahun" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Jenis Kelamin</label>
              <select name="jenis_kelamin" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all bg-white">
                <option value="">Pilih...</option>
                <option value="Laki-laki">Laki-laki</option>
                <option value="Perempuan">Perempuan</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nomor HP/WhatsApp</label>
            <input type="tel" name="no_hp" required placeholder="08xxxxxxxxxx" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all">
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Keluhan Singkat</label>
            <textarea name="keluhan" rows="2" required placeholder="Jelaskan keluhan Anda" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm resize-none transition-all"></textarea>
          </div>
        </div>

        <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-xs text-blue-700 leading-relaxed">
          <strong>Perhatian:</strong> Pendaftaran mandiri secara default masuk dalam kategori <strong>Prioritas Hijau (Rawat Jalan)</strong>. Jika Anda mengalami kondisi darurat (Kuning/Merah), harap segera menuju meja resepsionis / IGD klinik.
        </div>

        <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm font-medium text-center"></div>

        <button type="submit" class="w-full bg-blue-600 text-white py-3.5 rounded-xl font-bold text-lg hover:bg-blue-700 transition-all shadow-lg shadow-blue-600/30 active:scale-[0.98]">
          Dapatkan Nomor Antrean
        </button>
      </form>
    </div>
    
    <div class="text-center mt-6">
      <a href="/antrean" class="text-blue-600 hover:text-blue-700 text-sm font-semibold underline">Lihat Status Antrean Saat Ini</a>
    </div>
  </div>

  <!-- Halaman Sukses -->
  <div id="page-sukses" class="hidden w-full max-w-md">
    <div class="bg-white rounded-3xl shadow-xl p-10 text-center relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-2 bg-green-500"></div>
      <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <span class="text-4xl">✅</span>
      </div>
      
      <h2 class="text-2xl font-bold text-gray-800 mb-2">Pendaftaran Berhasil!</h2>
      <p class="text-gray-500 text-sm mb-8">Harap simpan atau screenshot halaman ini.</p>
      
      <div class="bg-gray-50 rounded-2xl p-6 mb-8 border border-gray-100">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-2">Nomor Antrean Anda</p>
        <p id="sukses-nomor" class="text-6xl font-black text-blue-600 tracking-tighter"></p>
        <div class="mt-4 inline-block bg-green-100 text-green-700 px-4 py-1.5 rounded-full text-xs font-bold">
          Prioritas Hijau
        </div>
      </div>
      
      <a href="/antrean" class="block w-full bg-blue-600 text-white py-3.5 rounded-xl font-bold text-lg hover:bg-blue-700 transition-all shadow-lg shadow-blue-600/30">
        Pantau Antrean
      </a>
      <button onclick="resetDaftar()" class="block w-full text-gray-500 hover:text-gray-700 py-3 mt-2 font-medium transition-colors">
        Daftarkan Pasien Lain
      </button>
    </div>
  </div>

  <script src="/js/daftar-mandiri.js"></script>
</body>
</html>