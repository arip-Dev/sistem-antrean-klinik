<%- include('../partials/head', { title: 'Dashboard' }) %>
<body class="bg-gray-50 min-h-screen font-sans">
  <%- include('../partials/navbar', { user }) %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Dashboard Antrean</h1>
        <p class="text-sm text-gray-500 mt-1">Kelola antrean pasien hari ini</p>
      </div>
      <div class="flex items-center gap-3">
        <div id="status-koneksi" class="flex items-center gap-1.5 text-xs text-gray-400">
          <span class="w-2 h-2 rounded-full bg-gray-300"></span> Menghubungkan...
        </div>
        <button onclick="openModal()" class="bg-blue-600 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-blue-700 transition-colors text-sm">
          + Pasien Baru
        </button>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wide">Total Antrean</p>
        <p id="stat-total" class="text-2xl font-bold text-gray-800 mt-1">0</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wide">Menunggu</p>
        <p id="stat-menunggu" class="text-2xl font-bold text-blue-600 mt-1">0</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wide">Dipanggil</p>
        <p id="stat-dipanggil" class="text-2xl font-bold text-amber-600 mt-1">0</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
        <p class="text-xs text-gray-500 uppercase tracking-wide">Tidak Hadir</p>
        <p id="stat-tidakhadir" class="text-2xl font-bold text-gray-500 mt-1">0</p>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="font-semibold text-gray-800">Daftar Antrean Hari Ini</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-gray-500 uppercase text-xs tracking-wide">
            <tr>
              <th class="px-5 py-3 text-left">No</th>
              <th class="px-5 py-3 text-left">Nama Pasien</th>
              <th class="px-5 py-3 text-left">Keluhan</th>
              <th class="px-5 py-3 text-center">Prioritas</th>
              <th class="px-5 py-3 text-center">Sumber</th>
              <th class="px-5 py-3 text-center">Status</th>
              <th class="px-5 py-3 text-left">Waktu</th>
              <th class="px-5 py-3 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="tabel-antrean" class="divide-y divide-gray-100">
            <tr><td colspan="8" class="px-5 py-10 text-center text-gray-400">Memuat data...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Tambah Pasien -->
  <div id="modal-tambah" class="hidden fixed inset-0 z-50">
    <div class="absolute inset-0 bg-black/40" onclick="closeModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg relative">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
          <h3 class="font-semibold text-gray-800 text-lg">Daftarkan Pasien Baru</h3>
          <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
        </div>
        <form id="form-tambah" class="p-6 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div class="col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1">Nama Pasien</label>
              <input type="text" name="nama_pasien" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Usia</label>
              <input type="number" name="usia" min="0" max="150" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Jenis Kelamin</label>
              <select name="jenis_kelamin" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm">
                <option value="">Pilih</option>
                <option value="Laki-laki">Laki-laki</option>
                <option value="Perempuan">Perempuan</option>
              </select>
            </div>
            <div class="col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1">No. HP</label>
              <input type="tel" name="no_hp" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm">
            </div>
            <div class="col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1">Keluhan</label>
              <textarea name="keluhan" rows="2" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm resize-none"></textarea>
            </div>
            <div class="col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-2">Tingkat Prioritas</label>
              <div class="grid grid-cols-3 gap-2">
                <label class="cursor-pointer">
                  <input type="radio" name="prioritas" value="1" class="hidden peer" checked>
                  <div class="peer-checked:ring-2 peer-checked:ring-green-500 border-2 border-gray-200 peer-checked:border-green-500 rounded-xl p-3 text-center transition-all">
                    <span class="text-lg">🟢</span>
                    <p class="text-xs font-semibold text-gray-700 mt-1">Hijau</p>
                    <p class="text-[10px] text-gray-400">Rawat Jalan</p>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="prioritas" value="2" class="hidden peer">
                  <div class="peer-checked:ring-2 peer-checked:ring-yellow-500 border-2 border-gray-200 peer-checked:border-yellow-500 rounded-xl p-3 text-center transition-all">
                    <span class="text-lg">🟡</span>
                    <p class="text-xs font-semibold text-gray-700 mt-1">Kuning</p>
                    <p class="text-[10px] text-gray-400">Darurat</p>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="prioritas" value="3" class="hidden peer">
                  <div class="peer-checked:ring-2 peer-checked:ring-red-500 border-2 border-gray-200 peer-checked:border-red-500 rounded-xl p-3 text-center transition-all">
                    <span class="text-lg">🔴</span>
                    <p class="text-xs font-semibold text-gray-700 mt-1">Merah</p>
                    <p class="text-[10px] text-gray-400">Gawat Darurat</p>
                  </div>
                </label>
              </div>
            </div>
          </div>
          <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-2 rounded-lg text-sm"></div>
          <button type="submit" class="w-full bg-blue-600 text-white py-2.5 rounded-xl font-semibold hover:bg-blue-700 transition-colors text-sm">
            Daftarkan Pasien
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Sukses -->
  <div id="modal-sukses" class="hidden fixed inset-0 z-50">
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-8 text-center relative">
        <span class="text-5xl">✅</span>
        <h3 class="text-xl font-bold text-gray-800 mt-4">Pendaftaran Berhasil</h3>
        <div class="mt-4 bg-blue-50 rounded-xl p-4">
          <p class="text-sm text-gray-500">Nomor Antrean</p>
          <p id="sukses-nomor" class="text-4xl font-black text-blue-600 mt-1"></p>
        </div>
        <button onclick="closeSuksesModal()" class="mt-6 w-full bg-blue-600 text-white py-2.5 rounded-xl font-semibold hover:bg-blue-700 transition-colors text-sm">
          Tutup
        </button>
      </div>
    </div>
  </div>

  <script src="/js/admin-dashboard.js"></script>
</body>
</html>
